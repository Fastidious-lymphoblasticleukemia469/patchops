# AWX Environment Configuration
# Copy this file to awx/.env and fill in real values before running AWX.
# awx/.env is gitignored.

# =============================================================================
# REQUIRED: Basic Configuration
# =============================================================================

# AWX image version - use a specific stable version
AWX_VERSION=24.6.1

# Port to expose the AWX UI on the host.
# 8080 collides with aptly's own API port (see ../inventory.ini / aptly.conf's
# aptly_api_listen ":8080") if you're also running the lab stack — use 8081.
AWX_PORT=8081

# Absolute path to your SSH private key for the patchops fleet on THIS host
# (matches ansible.cfg's private_key_file). Mounted read-only into awx_web
# so launch_web.sh can register it as the patchops-machine-ssh credential.
SSH_KEY_PATH=/home/youruser/.ssh/personal

# =============================================================================
# REQUIRED: Security - Generate Unique Values
# =============================================================================

# Admin login for the AWX web UI
AWX_ADMIN_USER=admin
AWX_ADMIN_PASSWORD=your-secure-password-here

# Email for the admin user
AWX_ADMIN_EMAIL=admin@example.com

# Database password - must match POSTGRES_PASSWORD below (AWX's own DB, not patchgov)
AWX_DB_PASSWORD=your-database-password-here

# Secret key - MUST be a long random string, unique per deployment.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must stay stable across restarts or you'll lose access to encrypted credentials.
AWX_SECRET_KEY=your-32-char-hex-secret-key-here

# Ansible vault password — must match the value used to encrypt
# ../group_vars/all/vault.yml (i.e. the contents of ../.vault_pass).
AWX_VAULT_PASSWORD=your-vault-password

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

# PostgreSQL settings (defaults shown)
# AWX_DB_HOST=postgres
# AWX_DB_PORT=5432
# AWX_DB_NAME=awx
# AWX_DB_USER=awx

# Redis settings (defaults shown)
# REDIS_HOST=redis
# REDIS_PORT=6379

# =============================================================================
# NOTES:
# =============================================================================
#
# 1. Change all default passwords before any real use.
# 2. AWX_SECRET_KEY must be stable across restarts or you'll lose access.
# 3. This AWX instance has its own Postgres/Redis — separate from patchops'
#    own patchgov governance DB in ../compose.yml.
# 4. Resource recommendations:
#    - awx_task: 2-4 CPU cores, 4-8GB RAM
#    - awx_web: 1-2 CPU cores, 2-4GB RAM
#    - postgres: 1 CPU core, 1GB RAM
#    - redis: 0.5 CPU core, 512MB RAM
