# Ansible Lab Environment Configuration
# Copy this to .env and fill in your own values.

# Your SSH public key content (from ~/.ssh/personal.pub)
PUBLIC_KEY=ssh-ed25519 AAAA... your-key-here

# SMTP creds for patch notifications (optional — leave unset to disable email)
SMTP_USERNAME=
SMTP_PASSWORD=

# Governance DB / Grafana admin password.
# Must match vault_govdb_password / vault_grafana_admin_password in
# group_vars/all/vault.yml (edit with: ansible-vault edit group_vars/all/vault.yml).
# docker compose reads these two; Ansible reads the vaulted copies — they are
# two separate secret stores that must be kept in sync by hand.
GOVDB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Ansible Vault password for group_vars/all/vault.yml.
# Generate your own and store it in .vault_pass (gitignored, referenced by
# ansible.cfg's vault_password_file) — do not reuse this example value.
# echo -n 'your-random-password' > .vault_pass
