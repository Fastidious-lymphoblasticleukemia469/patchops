      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "patchgov"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_scan AS (SELECT DISTINCT ON (hostname) id, hostname FROM scan_results WHERE env_name IN (${env}) ORDER BY hostname, scan_timestamp DESC) SELECT COALESCE(MAX(spd.cvss_score), 0) AS value FROM latest_scan ls JOIN scan_package_details spd ON spd.scan_id = ls.id WHERE ls.hostname IN (${hostname}) AND spd.is_security = true AND (spd.cve_priority IN (${cve_priority}) OR (spd.cve_priority IS NULL AND 'unknown' IN (${cve_priority})))",
          "refId": "A"
        }
      ],
      "title": "Highest CVSS (Filtered)",
      "type": "stat"
    },
