          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_scan AS (SELECT DISTINCT ON (hostname) id, hostname FROM scan_results WHERE env_name IN (${env}) ORDER BY hostname, scan_timestamp DESC) SELECT COALESCE(spd.cve_priority, 'unknown') AS cve_priority, COUNT(*) AS count FROM latest_scan ls JOIN scan_package_details spd ON spd.scan_id = ls.id WHERE ls.hostname IN (${hostname}) AND spd.is_security = true AND (spd.cve_priority IN (${cve_priority}) OR (spd.cve_priority IS NULL AND 'unknown' IN (${cve_priority}))) GROUP BY COALESCE(spd.cve_priority, 'unknown') ORDER BY CASE COALESCE(spd.cve_priority, 'unknown') WHEN 'critical' THEN 1 WHEN 'high' THEN 2 WHEN 'medium' THEN 3 WHEN 'low' THEN 4 WHEN 'negligible' THEN 5 ELSE 6 END",
