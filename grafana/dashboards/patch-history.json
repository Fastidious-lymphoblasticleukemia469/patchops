  },
  "description": "Audit log of all patch operations applied to hosts.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": false,
      "tags": ["patching"],
      "title": "Fleet & Snapshots",
      "tooltip": "Current patch state and snapshot promotion status",
      "type": "dashboard",
      "url": "/d/patch-ops"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": false,
      "tags": ["patching"],
      "title": "Package Upgrades",
      "tooltip": "Every pending package, host by host",
      "type": "dashboard",
      "url": "/d/patch-packages"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Patch Activity",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "patchgov" },
      "description": "Total patch operations in the selected time range and environment.",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#5794F2", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#5794F2", "value": null }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "patchgov" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM patch_history WHERE $__timeFilter(patch_timestamp) AND env_name IN (${env})",
          "refId": "A"
        }
      ],
      "title": "Patches Applied",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "patchgov" },
      "description": "Patch operations completed successfully.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "patchgov" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM patch_history WHERE $__timeFilter(patch_timestamp) AND env_name IN (${env}) AND status = 'completed'",
          "refId": "A"
        }
      ],
      "title": "Successful",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "patchgov" },
      "description": "Failed patch operations.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "patchgov" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM patch_history WHERE $__timeFilter(patch_timestamp) AND env_name IN (${env}) AND status = 'failed'",
          "refId": "A"
        }
      ],
      "title": "Failed",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "patchgov" },
      "description": "Hosts rebooted as part of a patch operation.",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#5794F2", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#5794F2", "value": null }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "patchgov" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM patch_history WHERE $__timeFilter(patch_timestamp) AND env_name IN (${env}) AND reboot_done = true",
          "refId": "A"
        }
      ],
      "title": "Rebooted",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Patch Log",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "patchgov" },
      "description": "Complete audit log of patch operations.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "patch_timestamp" },
            "properties": [
              { "id": "displayName", "value": "Patched At" },
              { "id": "unit", "value": "dateTimeAsIso" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "hostname" },
            "properties": [{ "id": "displayName", "value": "Hostname" }]
          },
          {
            "matcher": { "id": "byName", "options": "env_name" },
            "properties": [{ "id": "displayName", "value": "Environment" }]
          },
          {
            "matcher": { "id": "byName", "options": "patch_type" },
            "properties": [{ "id": "displayName", "value": "Type" }]
          },
          {
            "matcher": { "id": "byName", "options": "snapshot_used" },
            "properties": [{ "id": "displayName", "value": "Snapshot" }]
          },
          {
            "matcher": { "id": "byName", "options": "packages_changed" },
            "properties": [{ "id": "displayName", "value": "Packages" }]
          },
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              { "id": "displayName", "value": "Status" },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "completed": { "color": "green",  "index": 0, "text": "COMPLETED" },
                      "failed":    { "color": "red",    "index": 1, "text": "FAILED" },
                      "partial":   { "color": "orange", "index": 2, "text": "PARTIAL" }
                    },
                    "type": "value"
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "reboot_done" },
            "properties": [
              { "id": "displayName", "value": "Rebooted" },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "true":  { "color": "green", "index": 0, "text": "YES" },
                      "false": { "color": "text",  "index": 1, "text": "-" }
                    },
                    "type": "value"
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "operator" },
            "properties": [{ "id": "displayName", "value": "Operator" }]
          },
          {
            "matcher": { "id": "byName", "options": "awx_job_id" },
            "properties": [{ "id": "displayName", "value": "Job ID" }]
          }
        ]
      },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": true, "fields": "", "reducer": ["count"], "show": true },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Patched At" }]
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "patchgov" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT patch_timestamp, hostname, env_name, COALESCE(patch_type, '-') AS patch_type, COALESCE(snapshot_used, '-') AS snapshot_used, COALESCE(packages_changed, 0) AS packages_changed, COALESCE(status, '-') AS status, reboot_done::text, COALESCE(operator, '-') AS operator, COALESCE(awx_job_id, '-') AS awx_job_id FROM patch_history WHERE $__timeFilter(patch_timestamp) AND env_name IN (${env}) ORDER BY patch_timestamp DESC",
          "refId": "A"
        }
      ],
      "title": "Patch History",
      "type": "table"
    }
  ],
  "refresh": "1h",
  "schemaVersion": 39,
  "tags": ["patching", "history", "audit"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "postgres", "uid": "patchgov" },
        "definition": "SELECT DISTINCT env_name FROM scan_results ORDER BY 1",
        "description": "Filter by environment.",
        "hide": 0,
        "includeAll": true,
        "label": "Environment",
        "multi": true,
        "name": "env",
        "options": [],
        "query": "SELECT DISTINCT env_name FROM scan_results ORDER BY 1",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5m", "15m", "30m", "1h", "6h", "12h", "1d"]
  },
  "timezone": "utc",
  "title": "Patch Governance | History",
  "uid": "patch-history",
  "version": 1
}
